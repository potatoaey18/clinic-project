# Copy this file to .env for local development.
# In production (Vercel), set these as Environment Variables in the
# project settings instead of committing a .env file.

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxx"

# Same values, exposed to the client bundle by Vite (must be prefixed VITE_)
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxx"

# Server-only, service role key. NEVER prefix with VITE_ or expose to the client.
# Required by src/integrations/supabase/client.server.ts (admin operations).
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxx"
